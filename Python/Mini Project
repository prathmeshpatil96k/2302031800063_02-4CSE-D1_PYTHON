import tkinter as tk
from tkinter import messagebox

# Initialize window
root = tk.Tk()
root.title("Tic Tac Toe")
root.configure(bg="#00b3b3")  # Light blue background for the window
root.resizable(False, False)

current_player = "X"
board = [["" for _ in range(3)] for _ in range(3)]
buttons = [[None for _ in range(3)] for _ in range(3)]

# Stylish label for turn status
status = tk.Label(
    root,
    text="Turn: Player X",
    font=("Helvetica", 16, "bold"),
    bg="#00b3b3",
    fg="#003366",
    pady=10
)
status.grid(row=0, column=0, columnspan=3)

def check_winner():
    for i in range(3):
        if board[i][0] == board[i][1] == board[i][2] != "":
            return True
        if board[0][i] == board[1][i] == board[2][i] != "":
            return True
    if board[0][0] == board[1][1] == board[2][2] != "":
        return True
    if board[0][2] == board[1][1] == board[2][0] != "":
        return True
    return False

def is_draw():
    return all(cell != "" for row in board for cell in row)

def on_click(row, col):
    global current_player

    if board[row][col] == "":
        board[row][col] = current_player
        buttons[row][col].config(text=current_player, state="disabled", disabledforeground="#ffffff")
        
        # Adding color to clicked buttons
        if current_player == "X":
            buttons[row][col].config(bg="#ff6666")  # Red color for X
        else:
            buttons[row][col].config(bg="#66cc66")  # Green color for O

        if check_winner():
            status.config(text=f"Player {current_player} wins!", fg="#ff3366")
            disable_all_buttons()
            messagebox.showinfo("Game Over!", f"Congratulations! Player {current_player} wins!", icon='info')
            reset_game()  # Reset the game automatically after "OK"
        elif is_draw():
            status.config(text="It's a draw!", fg="#cc0000")
            messagebox.showinfo("Game Over!", "It’s a draw! Well played both.", icon='info')
            reset_game()  # Reset the game automatically after "OK"
        else:
            current_player = "O" if current_player == "X" else "X"
            status.config(text=f"Turn: Player {current_player}", fg="#003366")

def disable_all_buttons():
    for i in range(3):
        for j in range(3):
            buttons[i][j]["state"] = "disabled"

def reset_game():
    global current_player, board
    current_player = "X"
    board = [["" for _ in range(3)] for _ in range(3)]
    status.config(text="Turn: Player X", fg="#003366")

    for i in range(3):
        for j in range(3):
            buttons[i][j].config(text="", state="normal", bg="#f0f0f0", relief="raised")

# Game grid with vibrant color borders
for i in range(3):
    for j in range(3):
        btn = tk.Button(
            root, text="", width=6, height=3,
            font=("Arial", 28, "bold"),
            bg="#f0f0f0", fg="#003366",
            relief="raised", bd=4,
            activebackground="#00b3b3",  # Change on hover
            command=lambda row=i, col=j: on_click(row, col)
        )
        btn.grid(row=i+1, column=j, padx=5, pady=5, sticky="nsew")
        buttons[i][j] = btn

# Reset button with gradient effect and color
reset_btn = tk.Button(
    root, text="Restart Game",
    font=("Arial", 13, "bold"),
    bg="#ffcc00", fg="white",
    padx=10, pady=5,
    relief="raised", bd=3,
    activebackground="#ffaa00",
    command=reset_game
)
reset_btn.grid(row=4, column=0, columnspan=3, pady=20)

# Configure grid weights for resizing
root.grid_rowconfigure(1, weight=1)
root.grid_rowconfigure(2, weight=1)
root.grid_rowconfigure(3, weight=1)
root.grid_columnconfigure(0, weight=1)
root.grid_columnconfigure(1, weight=1)
root.grid_columnconfigure(2, weight=1)

root.mainloop()
